# ------------------------------------------------------------------
# Zkopíruj do `.env` a vyplň reálné hodnoty. `.env` se NEcommituje.
# Na Cloud Run se nastavují proměnné služby (tajemství přes Secret Manager).
# ------------------------------------------------------------------

# --- Firestore (Native) ---
# Na Cloud Run se projekt i přihlášení detekují automaticky (ADC) – nic nenastavuj.
# Lokálně se přihlas přes `gcloud auth application-default login` a nastav projekt:
GOOGLE_CLOUD_PROJECT="datalayer-web"
# FIRESTORE_PROJECT_ID="datalayer-web"   # alternativní override

# Lokální Firestore emulátor (volitelné, místo reálného projektu):
# FIRESTORE_EMULATOR_HOST="localhost:8080"

# Port (Cloud Run nastavuje automaticky na 8080).
PORT=3000

# Vývojová HTTP Basic Auth ochrana celého webu (jako v původním Nette webu).
# Zapni nastavením ENABLE_AUTH=1; dokud je zapnutá, server posílá X-Robots-Tag: noindex.
ENABLE_AUTH=0
SITE_USER="vn"
SITE_PASS="555"

# Admin session – podepisování cookie. V produkci NASTAV na náhodný řetězec:
#   openssl rand -base64 32
SESSION_SECRET="dev-secret-change-me"

# --- Kontaktní formulář ---
# Cloudflare Turnstile (ochrana proti robotům). Dokud nejsou vyplněné OBA klíče,
# je ověření vypnuté (platí jen honeypot a limit frekvence).
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Odesílání poptávek e-mailem (SMTP). Bez SMTP_HOST se zprávy jen ukládají
# do Firestore a čtou v administraci (/admin/messages). Příjemci se nastavují
# v administraci (/admin/settings).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# SMTP_SECURE="1"            # vynutí TLS od začátku (výchozí: jen pro port 465)
MAIL_FROM="datalayer.cz <web@datalayer.cz>"

# --- Migrace (docs/migrace.md) ---
# Token pro migrační URL /migrate (min. 32 znaků). Nastavit jen na dobu potřeby.
# MIGRATION_TOKEN=""
